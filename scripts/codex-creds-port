#!/usr/bin/env python3
"""Copy ChatGPT account logins between CliGate and CLIProxyAPI. Never prints a token.

`to-cliproxyapi` and `to-cligate` copy every account one way.
`newest` copies each account from the side whose access token expires later, so both
proxies keep working while only one of them refreshes a login.
CliGate accounts that are missing on its side are not created; log in there first.
"""
import argparse
import json
import os
import tempfile
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
CLIGATE = Path(os.environ.get("CLIGATE_ACCOUNTS", HOME / ".local/share/cligate-canary/config/accounts.json"))
CLIPROXYAPI = Path(os.environ.get("CLIPROXYAPI_AUTH_DIR", HOME / ".local/share/cliproxyapi-trial/auths"))


def write_private(path: Path, value: object) -> None:
    """Replace `path` atomically with JSON readable by the owner only."""
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    with os.fdopen(handle, "w") as file:
        json.dump(value, file, indent=2)
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def iso(ms: int) -> str:
    return datetime.fromtimestamp(ms / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ms_of(text: str) -> int:
    return int(datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp() * 1000) if text else 0


def proxy_path(account: dict) -> Path:
    return CLIPROXYAPI / f"codex-{account['email']}-{account.get('planType') or 'unknown'}.json"


def to_cliproxyapi(account: dict) -> None:
    """Write one CliGate account as a CLIProxyAPI auth file, keeping that file's other fields."""
    path = proxy_path(account)
    auth = json.loads(path.read_text()) if path.exists() else {}
    auth.update(
        type="codex",
        email=account["email"],
        account_id=account.get("accountId", ""),
        plan_type=account.get("planType", ""),
        id_token=account.get("idToken", ""),
        access_token=account.get("accessToken", ""),
        refresh_token=account.get("refreshToken", ""),
        expired=iso(account.get("expiresAt") or 0),
        last_refresh=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        disabled=account.get("enabled") is False,
    )
    write_private(path, auth)


def to_cligate(account: dict, auth: dict) -> None:
    """Put one CLIProxyAPI login into a CliGate account and clear a stale invalid mark."""
    changed = account.get("accessToken") != auth.get("access_token")
    account.update(
        idToken=auth.get("id_token", ""),
        accessToken=auth.get("access_token", ""),
        refreshToken=auth.get("refresh_token", ""),
        expiresAt=ms_of(auth.get("expired", "")),
        enabled=not auth.get("disabled", False),
    )
    if changed:
        for key in ("isInvalid", "invalidReason", "invalidAt", "refreshFailure"):
            account.pop(key, None)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("direction", choices=["to-cliproxyapi", "to-cligate", "newest"])
    direction = parser.parse_args().direction
    CLIPROXYAPI.mkdir(mode=0o700, parents=True, exist_ok=True)
    store = json.loads(CLIGATE.read_text())
    counts = {"to-cliproxyapi": 0, "to-cligate": 0}
    for account in store["accounts"]:
        path = proxy_path(account)
        auth = json.loads(path.read_text()) if path.exists() else None
        way = direction
        if direction == "newest":
            theirs = ms_of(auth.get("expired", "")) if auth else -1
            ours = account.get("expiresAt") or 0
            way = "to-cligate" if theirs > ours else "to-cliproxyapi" if ours > theirs else None
        if way == "to-cliproxyapi":
            to_cliproxyapi(account)
        elif way == "to-cligate" and auth:
            to_cligate(account, auth)
        else:
            continue
        counts[way] += 1
    if counts["to-cligate"]:
        write_private(CLIGATE, store)
    print(json.dumps(counts))


if __name__ == "__main__":
    main()
