#!/usr/bin/env python3
"""Warn when Codex requests fail or wait long at the throttle.

Run from a timer. Reads the proxy's main log for `429` replies that reached a
client and the journal of `codex-throttle` for how long requests waited for their
turn. The throttle caps the rate that reaches the provider, so long waits,
not the rate, show that more agents ask than it lets through. Sends each kind of warning with
`amh tell manager`, at most once per `--quiet-min`; `--print` prints instead of sending.
The quota budget part moved into `amh quota serve` (agent_managers/docs/quota-manager.md).

Observed on 2026-10-12: no refusal at 13 to 33 requests per minute, refusals at 63 to 66.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

HOME = Path.home()
LOG = Path(os.environ.get("CLIPROXYAPI_MAIN_LOG", HOME / ".local/share/cliproxyapi-trial/auths/logs/main.log"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "codex-load-watch.json"
REQUEST = re.compile(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d):\d\d\] .*gin_logger\.go:\d+\] (\d{3}) \|.*POST +"/v1/responses"')
TAIL_BYTES = 2_000_000
TELL_MAX_CHARS = 500
"""`amh tell manager` refuses over 600 characters ("write details to a file and name its path"); longer warnings go to a file."""


def load(minutes: int) -> tuple[Counter[str], int]:
    """Requests per minute and client-visible `429` replies in the last `minutes` whole minutes."""
    with LOG.open("rb") as file:
        file.seek(max(0, LOG.stat().st_size - TAIL_BYTES))
        lines = file.read().decode(errors="replace").splitlines()
    now = datetime.now().replace(second=0, microsecond=0)
    wanted = {(now - timedelta(minutes=back)).strftime("%Y-%m-%d %H:%M") for back in range(1, minutes + 1)}
    per_minute: Counter[str] = Counter()
    n_refused = 0
    for line in lines:
        found = REQUEST.match(line)
        if found and found[1] in wanted:
            per_minute[found[1]] += 1
            n_refused += found[2] == "429"
    return per_minute, n_refused


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--task-file", default="amh_support_codex.md", help="the task the warning is sent from")
    parser.add_argument("--minutes", type=int, default=10, help="how far back to count requests")
    parser.add_argument("--long-wait-s", type=float, default=30, help="mean wait at the throttle that counts as long")
    parser.add_argument("--quiet-min", type=float, default=60, help="minutes before the same kind of rate warning is sent again")
    parser.add_argument("--print", action="store_true", help="print the readings and warnings; send nothing")
    args = parser.parse_args()
    per_minute, n_refused = load(args.minutes)
    peak_minute, peak = max(per_minute.items(), key=lambda item: item[1], default=("", 0))
    journal = subprocess.run(
        ["journalctl", "--user", "-u", "codex-throttle.service", "--since", f"-{args.minutes}min", "--no-pager", "-o", "cat"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    waits_s = [float(found[1]) for found in re.finditer(r"held a request ([\d.]+) s", journal.stdout)]
    mean_wait_s = sum(waits_s) / len(waits_s) if waits_s else 0.0
    warnings = {}
    if n_refused:
        warnings["refused"] = f"Codex proxy: {n_refused} request(s) failed with 429 for clients in the last {args.minutes} min; peak {peak} requests per minute at {peak_minute[-5:]}."
    elif mean_wait_s >= args.long_wait_s:
        warnings["waits"] = f"Codex throttle: requests waited {mean_wait_s:.0f} s on average in the last {args.minutes} min ({peak} per minute let through); adding agents now only lengthens the wait."
    if args.print:
        print(f"peak {peak}/min at {peak_minute}; mean wait {mean_wait_s:.0f} s; 429 to clients: {n_refused}")
        print("\n".join(warnings.values()))
        return 0
    try:
        sent_at = json.loads(STATE.read_text())
    except (OSError, ValueError):
        sent_at = {}
    now_s = time.time()
    for kind, text in warnings.items():
        if now_s - sent_at.get(kind, 0) < args.quiet_min * 60:
            continue
        if len(text) > TELL_MAX_CHARS:
            detail = STATE.with_name(f"codex-load-watch-{kind}.txt")
            detail.write_text(text + "\n")
            text = f"{text.splitlines()[0][:300]} Details: {detail}"
        told = subprocess.run(["amh", "tell", "manager", "--task-file", args.task_file, text], capture_output=True, text=True, timeout=120)
        if told.returncode:
            print(f"codex-load-watch: amh tell manager failed: {told.stderr.strip()}", file=sys.stderr)
            return 1
        sent_at[kind] = now_s
    STATE.write_text(json.dumps(sent_at))
    return 0


if __name__ == "__main__":
    sys.exit(main())
